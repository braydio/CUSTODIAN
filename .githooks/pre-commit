#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ─────────────────────────────────────────────
# 1. Block forbidden staged files
# ─────────────────────────────────────────────
#
# ACMR deliberately excludes deletions, so removing an accidentally tracked
# forbidden file is allowed.
#
staged_paths="$(git diff --cached --name-only --diff-filter=ACMR)"

forbidden_pattern='(^|/)(auth\.json|internal_storage\.json|history\.jsonl|olddauth\.json)$|^(log|shell_snapshots)/'

if [ -n "$staged_paths" ]; then
    forbidden_match="$(
        printf '%s\n' "$staged_paths" |
        grep -E "$forbidden_pattern" || true
    )"

    if [ -n "$forbidden_match" ]; then
        echo "Commit blocked: forbidden files or directories are staged." >&2
        echo >&2
        echo "Remove these paths from the commit:" >&2
        printf '%s\n' "$forbidden_match" >&2
        exit 1
    fi
fi


# ─────────────────────────────────────────────
# 2. Warn about misplaced Aseprite source files
# ─────────────────────────────────────────────
if [ -d "custodian/content" ]; then
    content_aseprite_files="$(
        printf '%s\n' "$staged_paths" |
        grep -E '^custodian/content/.*\.(aseprite|ase)$' |
        grep -v '/_aseprite/' || true
    )"

    if [ -n "$content_aseprite_files" ]; then
        content_aseprite_count="$(
            printf '%s\n' "$content_aseprite_files" |
            wc -l |
            tr -d ' '
        )"

        echo "Warning: staged .aseprite/.ase source files are outside content/_aseprite/." >&2
        echo "Showing first 25 of $content_aseprite_count:" >&2
        printf '%s\n' "$content_aseprite_files" | sed -n '1,25p' >&2
    fi
fi


# ─────────────────────────────────────────────
# 3. Warn about untracked local-state files
# ─────────────────────────────────────────────
untracked="$(
    git ls-files \
        --others \
        --exclude-standard \
        -- \
        log/ \
        sessions/ \
        shell_snapshots/ \
        2>/dev/null || true
)"

if [ -n "$untracked" ]; then
    echo "Warning: untracked local-state files exist:" >&2
    printf '%s\n' "$untracked" | sed -n '1,25p' >&2
fi


# ─────────────────────────────────────────────
# 4. Validate Design Codex when relevant
# ─────────────────────────────────────────────
if printf '%s\n' "$staged_paths" |
    grep -Eq '^(design/90_codex/|tools/validate_design_codex.py|\.githooks/pre-commit|tools/install_git_hooks.sh)'
then
    echo "[pre-commit] validating design codex..."
    python3 tools/validate_design_codex.py
fi

exit 0
