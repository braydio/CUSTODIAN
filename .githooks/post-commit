#!/usr/bin/env bash

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

# ─────────────────────────────────────────────
# 1. Git LFS post-commit
# ─────────────────────────────────────────────
if command -v git-lfs >/dev/null 2>&1; then
    git lfs post-commit "$@" || \
        echo "[post-commit] WARNING: git lfs post-commit failed." >&2
else
    echo "[post-commit] WARNING: git-lfs not found." >&2
fi


# ─────────────────────────────────────────────
# 2. Refresh code-review-graph
# ─────────────────────────────────────────────
if [ -x "$REPO_ROOT/tools/crg-refresh.sh" ]; then
    "$REPO_ROOT/tools/crg-refresh.sh" || \
        echo "[post-commit] WARNING: graph refresh failed." >&2
else
    echo "[post-commit] WARNING: tools/crg-refresh.sh not found/executable." >&2
fi


# ─────────────────────────────────────────────
# 3. Optional Google Drive backup
# ─────────────────────────────────────────────
if [ "${CUSTODIAN_SYNC_AFTER_COMMIT:-0}" = "1" ]; then
    if [ -x "$REPO_ROOT/rclone-git-sync.sh" ]; then
        LOG_DIR="$REPO_ROOT/.git/hooks-logs"
        mkdir -p "$LOG_DIR"

        nohup "$REPO_ROOT/rclone-git-sync.sh" \
            > "$LOG_DIR/rclone-git-sync.log" 2>&1 &

        echo "[post-commit] Started background Google Drive backup."
        echo "[post-commit] Log: $LOG_DIR/rclone-git-sync.log"
    else
        echo "[post-commit] WARNING: rclone-git-sync.sh unavailable." >&2
    fi
fi

exit 0
