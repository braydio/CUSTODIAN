{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "custodian.operator_3d_animation_batch.v1",
  "title": "Operator 3D animation candidate batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batch_id", "master_reference", "rendering_contract", "retarget_policy", "output_root", "animations"],
  "properties": {
    "schema": {"const": "custodian.operator_3d_animation_batch.v1"},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
    "master_reference": {"type": "object", "additionalProperties": false, "required": ["availability", "master_id", "contract_path", "contract_sha256"], "properties": {
      "availability": {"enum": ["available", "unavailable"]},
      "master_id": {"type": ["string", "null"]},
      "contract_path": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
      "contract_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
    }},
    "rendering_contract": {"type": "object", "additionalProperties": false, "required": ["contract_id", "contract_path", "contract_sha256", "profile_sha256", "directions", "width", "height", "channels", "elevation_degrees", "pixels_per_meter", "root_pixel", "scale_policy", "registration_policy", "mirroring", "diagnostic_size_px", "candidate_state"], "properties": {
      "contract_id": {"type": "string", "minLength": 1},
      "contract_path": {"$ref": "#/$defs/relative_path"},
      "contract_sha256": {"$ref": "#/$defs/sha256"},
      "profile_sha256": {"$ref": "#/$defs/sha256"},
      "directions": {"const": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]},
      "width": {"const": 128}, "height": {"const": 128}, "channels": {"const": "RGBA"},
      "elevation_degrees": {"const": 45}, "pixels_per_meter": {"const": 50}, "root_pixel": {"const": [64, 106]},
      "scale_policy": {"const": "fixed_from_master"}, "registration_policy": {"const": "fixed_root_all_frames"},
      "mirroring": {"const": false}, "diagnostic_size_px": {"enum": [null, 512]}, "candidate_state": {"const": "candidate_unapproved"}
    }},
    "retarget_policy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "version", "config_path", "config_sha256"], "properties": {
      "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"}, "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"}, "config_path": {"$ref": "#/$defs/relative_path"}, "config_sha256": {"$ref": "#/$defs/sha256"}
    }},
    "output_root": {"$ref": "#/$defs/relative_path"},
    "animations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/animation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\u0000]+$"},
    "nullable_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "nullable_path": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
    "nullable_string": {"type": ["string", "null"]},
    "nullable_number": {"type": ["number", "null"], "minimum": 0},
    "nullable_integer": {"type": ["integer", "null"]},
    "animation": {"type": "object", "additionalProperties": false, "required": ["animation_id", "source", "semantic", "output_path", "source_action", "source_skeleton", "authored_timing", "playback", "root_motion", "foot_contact", "sampling", "runtime_timing_authority"], "properties": {
      "animation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,63}$"},
      "output_path": {"$ref": "#/$defs/relative_path"},
      "source": {"type": "object", "additionalProperties": false, "required": ["availability", "original_filename", "relative_path", "sha256", "import_metadata"], "properties": {
        "availability": {"enum": ["available", "unavailable"]}, "original_filename": {"$ref": "#/$defs/nullable_string"}, "relative_path": {"$ref": "#/$defs/nullable_path"}, "sha256": {"$ref": "#/$defs/nullable_sha256"},
        "import_metadata": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["importer", "importer_version", "settings_sha256"], "properties": {"importer": {"type": "string", "minLength": 1}, "importer_version": {"type": "string", "minLength": 1}, "settings_sha256": {"$ref": "#/$defs/sha256"}}}]}
      }},
      "semantic": {"type": "object", "additionalProperties": false, "required": ["profile", "group", "action", "output_layer"], "properties": {"profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,63}$"}, "group": {"enum": ["locomotion", "posture", "attack", "defense", "reaction", "interaction", "transition", "cosmetic", "presentation"]}, "action": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,63}$"}, "output_layer": {"const": "full_body"}}},
      "source_action": {"type": "object", "additionalProperties": false, "required": ["identity", "inspection_proof_path", "inspection_proof_sha256"], "properties": {"identity": {"$ref": "#/$defs/nullable_string"}, "inspection_proof_path": {"$ref": "#/$defs/nullable_path"}, "inspection_proof_sha256": {"$ref": "#/$defs/nullable_sha256"}}},
      "source_skeleton": {"type": "object", "additionalProperties": false, "required": ["identity", "signature_sha256", "compatibility_proof_id"], "properties": {"identity": {"$ref": "#/$defs/nullable_string"}, "signature_sha256": {"$ref": "#/$defs/nullable_sha256"}, "compatibility_proof_id": {"$ref": "#/$defs/nullable_string"}}},
      "authored_timing": {"type": "object", "additionalProperties": false, "required": ["availability", "duration_seconds", "fps", "frame_start", "frame_end"], "properties": {"availability": {"enum": ["available", "unavailable"]}, "duration_seconds": {"$ref": "#/$defs/nullable_number"}, "fps": {"type": ["number", "null"], "minimum": 0}, "frame_start": {"$ref": "#/$defs/nullable_integer"}, "frame_end": {"$ref": "#/$defs/nullable_integer"}}},
      "playback": {"type": "object", "additionalProperties": false, "required": ["classification", "character_local_impact_direction"], "properties": {"classification": {"enum": ["loop", "one_shot"]}, "character_local_impact_direction": {"enum": [null, "front", "back", "left", "right"]}}},
      "root_motion": {"type": "object", "additionalProperties": false, "required": ["source_state", "source_trajectory_sha256", "policy", "trajectory_retention", "pose_root_translation", "godot_application"], "properties": {"source_state": {"enum": ["present", "absent", "unknown"]}, "source_trajectory_sha256": {"$ref": "#/$defs/nullable_sha256"}, "policy": {"enum": ["preserve_world_displacement", "extract_to_metadata", "in_place"]}, "trajectory_retention": {"const": "preserve_original_separately"}, "pose_root_translation": {"enum": ["retained", "removed"]}, "godot_application": {"enum": ["pose_only", "trajectory_once_separately"]}}},
      "foot_contact": {"type": "object", "additionalProperties": false, "required": ["policy", "evidence_path", "evidence_sha256"], "properties": {"policy": {"enum": ["not_assessed", "preserve_source_contacts", "enforce_contacts", "no_contacts_expected"]}, "evidence_path": {"$ref": "#/$defs/nullable_path"}, "evidence_sha256": {"$ref": "#/$defs/nullable_sha256"}}},
      "sampling": {"type": "object", "additionalProperties": false, "required": ["mode", "stride", "loop_endpoint_policy"], "properties": {"mode": {"const": "source_frame_stride"}, "stride": {"type": "integer", "minimum": 1}, "loop_endpoint_policy": {"enum": ["include_authored_terminal", "omit_declared_duplicate_terminal"]}}},
      "runtime_timing_authority": {"type": "object", "additionalProperties": false, "required": ["status", "authority_id", "authority_path", "authority_sha256", "fps", "loop"], "properties": {"status": {"enum": ["approved", "unavailable"]}, "authority_id": {"$ref": "#/$defs/nullable_string"}, "authority_path": {"$ref": "#/$defs/nullable_path"}, "authority_sha256": {"$ref": "#/$defs/nullable_sha256"}, "fps": {"type": ["number", "null"], "minimum": 0}, "loop": {"type": ["boolean", "null"]}}
      }
    }}
  }
}
