{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "custodian.operator_3d_static_candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "candidate_identity_sha256", "status", "approved", "runtime_selection", "source", "dependencies", "render_profile", "renderer", "tool_sources", "normalization", "camera", "outputs", "review_files"],
  "properties": {
    "schema": {"const": "custodian.operator_3d_static_candidate.v1"},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}[a-z0-9]$|^[a-z0-9]$"},
    "candidate_identity_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "candidate_unapproved"},
    "approved": {"const": false},
    "runtime_selection": {"const": false},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {
      "path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 20}
    }},
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {
      "path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}
    }}},
    "render_profile": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
      "path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}
    }},
    "renderer": {"type": "object", "additionalProperties": false, "required": ["blender_version", "script_sha256", "color_management", "engine"], "properties": {
      "blender_version": {"type": "string", "minLength": 1}, "script_sha256": {"$ref": "#/$defs/sha256"}, "color_management": {"type": "object"}, "engine": {"type": "string"}
    }},
    "tool_sources": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
      "path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}
    }}},
    "normalization": {"type": "object", "additionalProperties": true, "required": ["applied_uniform_scale", "scale_fit_view", "target_s_height_px"]},
    "camera": {"type": "object", "additionalProperties": false, "required": ["projection", "elevation_degrees", "pixels_per_meter", "ortho_scale", "root_pixel", "directions", "mirroring", "registration"], "properties": {
      "projection": {"const": "orthographic"}, "elevation_degrees": {"const": 45}, "pixels_per_meter": {"const": 50}, "ortho_scale": {"const": 2.56}, "root_pixel": {"const": [64, 106]}, "directions": {"const": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]}, "mirroring": {"const": false}, "registration": {"const": "fixed_common_origin_all_directions"}
    }},
    "outputs": {"type": "object", "minProperties": 16, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "width", "height", "channels", "alpha_bounds"], "properties": {
      "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}, "width": {"enum": [128, 512]}, "height": {"enum": [128, 512]}, "channels": {"const": "RGBA"}, "alpha_bounds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}}
    }}},
    "review_files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes"], "properties": {
      "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}
    }}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"}
  }
}
