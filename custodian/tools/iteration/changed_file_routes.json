{
  "schema_version": 1,
  "rules": [
    {
      "id": "combat_audio",
      "include": [
        "custodian/content/audio/sfx/combat/**/*.wav",
        "custodian/content/audio/sfx/combat/*.wav",
        "custodian/game/**/audio*.gd"
      ],
      "exclude": ["**/*.import"],
      "tags": ["combat_audio"],
      "priority": 70,
      "reason": "Combat audio changed."
    },
    {
      "id": "operator_fast_attack",
      "include": [
        "custodian/content/sprites/operator/**/*fast*__*.png",
        "custodian/game/actors/operator/**/*.gd",
        "custodian/game/actors/operator/*.gd"
      ],
      "exclude": ["**/*.import", "reports/**"],
      "tags": ["fast_attack", "operator_animation", "parry", "field_patch"],
      "priority": 90,
      "reason": "Operator action presentation or authority changed."
    },
    {
      "id": "operator_heavy_attack",
      "include": [
        "custodian/content/sprites/operator/**/*heavy*__*.png",
        "custodian/game/actors/operator/**/*.gd",
        "custodian/game/actors/operator/*.gd"
      ],
      "exclude": ["**/*.import"],
      "tags": ["heavy_attack"],
      "priority": 85,
      "reason": "Operator heavy-attack presentation or authority changed."
    },
    {
      "id": "grunt",
      "include": [
        "custodian/game/actors/enemies/enemy_grunt*",
        "custodian/content/sprites/enemies/enemy_grunt/**"
      ],
      "exclude": ["**/*.import"],
      "tags": ["grunt"],
      "priority": 65,
      "reason": "Grunt behavior or presentation changed."
    },
    {
      "id": "marine",
      "include": [
        "custodian/game/actors/enemies/enemy_marine*",
        "custodian/content/sprites/enemies/enemy_marine/**"
      ],
      "exclude": ["**/*.import"],
      "tags": ["marine", "armor_deflect"],
      "priority": 75,
      "reason": "Marine armor/deflect behavior or presentation changed."
    },
    {
      "id": "field_patch",
      "include": [
        "custodian/content/audio/sfx/healing/**",
        "custodian/game/actors/operator/**/*field_patch*",
        "custodian/game/actors/operator/operator.gd"
      ],
      "exclude": ["**/*.import"],
      "scenario_ids": ["healing/field_patch_commit"],
      "priority": 85,
      "reason": "Field Patch behavior or presentation changed."
    },
    {
      "id": "sundered_keep_world_vista",
      "include": [
        "custodian/game/world/vistas/sundered_keep/**",
        "custodian/game/world/approaches/sundered_keep/**",
        "custodian/content/backgrounds/sundered_keep/**",
        "design/05_levels/SUNDERED_KEEP_WORLD_VISTA.md"
      ],
      "exclude": ["**/*.import"],
      "scenario_ids": ["vista/sundered_keep_first_reveal"],
      "priority": 100,
		"reason": "Sundered Keep world-Vista behavior or art changed."
	},
	{
		"id": "forlorn_ritualant_completion",
		"include": [
			"custodian/game/world/events/ash_bell/**",
			"custodian/game/world/levels/authored/ash_bell/forlorn_ritualant_underground/**",
			"custodian/content/dialogue/ash_bell/forlorn_ritualant_dialogue.json",
			"custodian/tools/validation/fixtures/forlorn_ritualant_completion_moment.*",
			"custodian/tools/iteration/scenarios/traversal/forlorn_ritualant_completion.json"
		],
		"exclude": ["**/*.import", "reports/**"],
		"scenario_ids": ["traversal/forlorn_ritualant_completion"],
		"priority": 115,
		"reason": "Forlorn Ritualant dialogue, combat, lower-lift, or departure presentation changed."
	},
	{
		"id": "ritualant_underground_landing_visual",
		"include": [
			"custodian/game/world/levels/authored/ash_bell/forlorn_ritualant_underground/**",
			"custodian/asset_drop/source_work/ritualant_scene/ritualant_landing_shelf_apron_*.png",
			"custodian/tools/validation/fixtures/ritualant_underground_landing_visual_moment.*",
			"custodian/tools/iteration/scenarios/traversal/ritualant_underground_landing_visual.json"
		],
		"exclude": ["**/*.import", "reports/**"],
		"scenario_ids": ["traversal/ritualant_underground_landing_visual"],
		"priority": 125,
		"reason": "Ritualant lower-lift landing, apron candidate, camera path, or visual-review fixture changed."
	},
	{
		"id": "ash_bell_lift",
		"include": [
			"custodian/game/world/approaches/ash_bell/**",
			"custodian/assets/sprites/world/ingress/ash_bell/**",
			"custodian/content/sprites/world/ingress/ash_bell/**",
			"custodian/tools/validation/fixtures/ash_bell_lift_moment.*",
			"custodian/tools/iteration/scenarios/traversal/ash_bell_lift_exterior_descent.json",
			"design/05_levels/ASH_BELL_LIFT_INGRESS_PRESENTATION.md"
		],
		"exclude": ["**/*.import", "reports/**"],
		"scenario_ids": ["traversal/ash_bell_lift_exterior_descent"],
		"priority": 110,
		"reason": "Ash Bell lift traversal behavior or landmark art changed."
	}
  ]
}
