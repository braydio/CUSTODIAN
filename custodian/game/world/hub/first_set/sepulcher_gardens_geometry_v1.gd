static func walkable_runs() -> Array[Rect2i]:
    var result: Array[Rect2i] = []
    for y in range(MASK_ROWS.size()):
        var row: String = MASK_ROWS[y]
        var start := -1
        for x in range(row.length() + 1):
            var filled := x < row.length() and row.substr(x, 1) == "1"
            if filled and start == -1:
                start = x
            elif not filled and start != -1:
                result.append(Rect2i(
                    start + HUB_GRID_OFFSET.x, y + HUB_GRID_OFFSET.y, x - start, 1
                ))
                start = -1
    return result

static func is_gardens_walkable_hub_cell(cell: Vector2i) -> bool:
    var local := cell - HUB_GRID_OFFSET
    if local.x < 0 or local.y < 0 or local.x >= SIZE_CELLS.x or local.y >= SIZE_CELLS.y:
        return false
    return MASK_ROWS[local.y].substr(local.x, 1) == "1"

static func total_walkable_cells() -> int:
    var count := 0
    for row in MASK_ROWS:
        count += row.count("1")
    return count
