      "layer": "body",
      "action_group": "special",
      "variant": "ninth_answer",
      "animation": true,
      "frames": 8,
      "fps": 8,
      "layout": "horizontal_strip",
      "frame_width": 128,
      "frame_height": 128
    },

    "orra_late": {
      "required": true,
      "layer": "body",
      "action_group": "special",
      "variant": "orra_late",
      "animation": true,
      "frames": 8,
      "fps": 8,
      "layout": "horizontal_strip",
      "frame_width": 128,
      "frame_height": 128
    },

    "dissolve": {
      "required": true,
      "layer": "body",
      "action_group": "death",
      "variant": "dissolve",
      "animation": true,
      "frames": 8,
      "fps": 6,
      "layout": "horizontal_strip",
      "frame_width": 128,
      "frame_height": 128
    },

    "death_violent": {
      "required": true,
      "layer": "body",
      "action_group": "death",
      "variant": "death_violent",
      "animation": true,
      "frames": 8,
      "fps": 8,
      "layout": "horizontal_strip",
      "frame_width": 128,
      "frame_height": 128
