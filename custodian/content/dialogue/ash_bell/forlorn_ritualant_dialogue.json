{
  "id": "ash_bell_forlorn_ritualant",
  "internal_name": "The Forlorn-Ritualant and the Unarrived",
  "public_name": "Forlorn-Ritualant",
  "continuity_origin": "ash_bell",
  "forbidden_terms": [
    "timeline",
    "alternate universe",
    "this version",
    "last time",
    "multiverse",
    "parallel world"
  ],
  "motifs": [
    "ninth_answer",
    "dry_fountain",
    "black_banners",
    "white_thread",
    "unarrived_saint",
    "ash_instead_of_snow"
  ],
  "nodes": {
    "proximity_intro": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Stop. Outside the white.",
        "delay": 0.0
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "The count is not finished.",
        "delay": 2.5
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Keep your boots clear of the thread.",
        "delay": 3.0
      }
    ],
    "first_interaction": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Custodian. Good. Count with me."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Bell above. Fountain below. West gate to our left. Black banners at the doors."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "The bell is wrong."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "The basin is wrong."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "There is no west gate."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Do not tell me this is another chapel."
      }
    ],
    "ask_bell": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "The one above us is a chapel bell."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Bronze. Rope. Tower. Ordinary things."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "The Ninth was never cast."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Nine stations. Eight Answers."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Station Nine was Orra's."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "We waited for the Ninth."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "It came late."
      }
    ],
    "ask_thread": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Name first. Wrist second."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "During the Silence we counted who crossed."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "The living. The dead."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Then people came through who remembered the wrong streets."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "So we tied everyone."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "If yours pulls tight, stop walking."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "If it snaps, do not answer anyone behind you."
      }
    ],
    "ask_orra": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "She had a post."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Station Nine."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "They told her to go straight there."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "She went back for the lower quarter."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Eight stations answered."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Orra did not."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Then she came."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Late."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "But she came."
      }
    ],
    "attack_response": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Ahh, Custodian."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "So fear found you early."
      }
    ],
    "cut_thread_response": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "No."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "That wasn't a cord."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "That was a name."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Do not turn around."
      }
    ],
    "peaceful_exit": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Go gently."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Some gates are closed by footsteps."
      }
    ],
    "stabilized_exit": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "The count holds."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Go."
      }
    ],
    "inspect_fountain": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "This is a basin. It is not the Fountain."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Wrong lip. Wrong depth. No east fracture."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "Someone built this where the Fountain should be."
      }
    ],
    "set_stilling_pin": [
      {
        "speaker": "Forlorn-Ritualant",
        "text": "The pin finds the basin."
      },
      {
        "speaker": "Forlorn-Ritualant",
        "text": "The count may still hold."
      }
    ],
    "pin_strike_bark": [{"speaker":"Forlorn-Ritualant","text":"Still."}],
    "thread_pull_bark": [{"speaker":"Forlorn-Ritualant","text":"Back to the count."}],
    "ninth_answer_bark": [{"speaker":"Forlorn-Ritualant","text":"Answer nothing."}],
    "orra_late_windup_bark": [{"speaker":"Forlorn-Ritualant","text":"Too early."}],
    "orra_late_resolve_bark": [{"speaker":"Forlorn-Ritualant","text":"Now."}]
  }
}
