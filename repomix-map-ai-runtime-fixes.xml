			"enter": 1.0,
			"return": 0.5,
			"camera": 0.5,
			"keep_alpha": 0.87,
			"fog_alpha": 0.28,
			"fog_offset": Vector2(-100.0, 46.0),
			"light_energy": 0.15,
		},
		{
			"position": after,
			"phase": "GAMEPLAY_AFTER",
			"enter": 1.0,
			"return": 1.0,
			"camera": 0.0,
			"keep_alpha": 0.82,
