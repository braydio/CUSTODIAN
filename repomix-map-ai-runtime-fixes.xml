        )
        assert "enemies/enemy_savage/runtime/body/" + enemy.name in enemy_paths
        assert "enemies/enemy_savage/" + enemy.name in enemy_paths
        assert not any(path.startswith("enemy_savage/") for path in enemy_paths)
