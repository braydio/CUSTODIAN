class_name RouteRuntimeFixture
extends RefCounted

const LEVEL_SCRIPT := preload("res://tools/validation/fixtures/route_test_level.gd")
const EXIT_SCRIPT := preload("res://game/world/levels/level_exit_2d.gd")
