func _assert_plan_parity(production_plan: Dictionary, lab_plan: Dictionary) -> void:
	_assert(
		COMPOSITOR.plan_fingerprint(production_plan) == COMPOSITOR.plan_fingerprint(lab_plan),
		"production/lab plan fingerprints diverged"
