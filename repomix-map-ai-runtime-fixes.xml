	_require(is_equal_approx(float(material.get_shader_parameter("bubble_alpha")), tilemap.combat_foliage_occlusion_alpha), "Combat foliage alpha should use combat profile.")

	enemy.queue_free()
	player.queue_free()


func _finish() -> void:
	if _failed:
