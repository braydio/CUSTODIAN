	kind = p_kind
	rect = p_rect
	cells = p_cells.duplicate()
	access_cells = p_access_cells.duplicate()


func to_dictionary() -> Dictionary:
	return {
		"kind": kind,
		"kind_name": kind_to_string(kind),
		"rect": rect,
		"cells": cells.duplicate(),
		"access_cells": access_cells.duplicate(),
		"discarded": discarded,
		"reason": reason,
	}


