	def.projectile_speed_px = float(stats.get("projectile_speed_px", 950.0))
	def.penetration = int(stats.get("penetration", 1))
	
	var ammo = data.get("ammo", {})
	def.ammo_type = String(ammo.get("ammo_type", "kinetic"))
