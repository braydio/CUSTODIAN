	local label="$1"
	shift
	echo
	echo "=== $label ==="
	"$@"
	local code=$?
	echo "=== exit_code=$code ==="
	if [[ "$code" -ne 0 && "$overall_code" -eq 0 ]]; then
		overall_code="$code"
