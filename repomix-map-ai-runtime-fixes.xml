const GRUNT_ANIMATION_LIBRARY := preload("res://game/enemies/procgen/grunt_animation_library.gd")

const REQUIRED_BODY_ANIMATIONS := {
	"idle_s": 10,
	"run_e": 10,
	"run_w": 10,
	"melee_e": 10,
	"melee_se": 10,
	"melee_sw": 10,
	"melee_w": 11,
	"stagger_s": 8,
	"stagger_e": 11,
	"stagger_w": 11,
	"special_windup_e": 6,
	"special_windup_w": 6,
	"special_inflight_e": 6,
	"special_inflight_w": 6,
	"special_recovery_e": 6,
	"special_recovery_w": 6,
	"crit_s": 8,
	"crit_recovery_s": 5,
	"death_e": 8,
	"flinch_s": 6,
	"flinch_e": 5,
	"flinch_w": 5,
}

const REQUIRED_FX_ANIMATIONS := {
