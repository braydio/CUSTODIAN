		"sensor_intelligence":{"contacts":[], "tracked_count":0, "current_count":0},
		"sensor_forecast":{"ingress":"north", "objective":"destroy_power", "composition":["grunt"]},
		"arrn":{"knowledge_index":3, "knowledge_max":7, "relays":[{"status":"STABLE"}]},
