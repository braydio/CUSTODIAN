	await _assert_mode(wave_manager, enemies, operator, &"critical_hold", PHASE_HOLD, &"critical_open_hold_s")
	await _assert_mode(wave_manager, enemies, operator, &"critical_recover", PHASE_RECOVER, &"critical_open_recover_s")
