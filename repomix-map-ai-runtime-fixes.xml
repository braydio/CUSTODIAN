        _write_strip(ally)

        enemy_manifest = manifests._build_manifest(enemy)
        enemy_paths = [output["path"] for output in enemy_manifest["outputs"]]
        assert enemy_paths[0] == (
            "enemies/enemy_savage/runtime/body/locomotion/"
