extends Node2D

enum TileType {
    WALL_STANDARD,
    WALL_REINFORCED, 
    WALL_DESTRUCTIBLE,
    WALL_POWER_CONDUIT,
    WALL_SENSOR,
    DOOR_STANDARD,
    DOOR_SECURE,
    GATE_EXPANSION,
    TURRET_MOUNT,
