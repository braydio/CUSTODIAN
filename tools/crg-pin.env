# Single source of truth for the code-review-graph install used by CUSTODIAN.
# Read by tools/crg-refresh.sh and verified against .mcp.json by
# tools/check_crg_config.py. The user-level ~/.codex/config.toml must match it.
#
# Lightweight install on purpose: the root graph has no embeddings, and
# semantic_search_nodes_tool falls back to keyword/FTS search without them.
# The [embeddings] extra pulls torch + CUDA (~5.9 GB in the uv cache).
CRG_VERSION=2.3.8
# Read-only MCP allowlist (serve --tools). Graph building stays in the CLI
# hook, so an agent cannot create a worktree-local graph through MCP.
CRG_MCP_TOOLS=list_graph_stats_tool,query_graph_tool,semantic_search_nodes_tool,get_impact_radius_tool,detect_changes_tool,get_review_context_tool,get_minimal_context_tool,get_architecture_overview_tool,list_communities_tool,get_community_tool,list_flows_tool,get_flow_tool,get_affected_flows_tool,get_hub_nodes_tool,get_bridge_nodes_tool,get_knowledge_gaps_tool,get_surprising_connections_tool,get_suggested_questions_tool,find_large_functions_tool,traverse_graph_tool
