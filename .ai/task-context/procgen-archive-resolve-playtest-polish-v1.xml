	var rbehind := Vector2i(OP.x + 7, OP.y + 5)
	var rfar := Vector2i(OP.x - 30, OP.y)
	o2.note_chunk_unloaded(Vector2i(int(floor(float(rnear.x) / CHUNK)), int(floor(float(rnear.y) / CHUNK))), CHUNK)
